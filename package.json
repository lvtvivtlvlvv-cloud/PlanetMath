{
  "name": "school-diary",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "prisma db push --skip-generate && next dev -p 3000 -H 0.0.0.0",
    "build": "prisma db push --skip-generate && next build",
    "start": "next start",
    "lint": "next lint",
    "setup": "prisma db push && tsx prisma/clean-and-setup-admin.ts",
    "db:push": "prisma db push",
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "5.19.0",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "jose": "^5.9.0",
    "lucide-react": "^0.441.0",
    "next": "14.2.13",
    "next-themes": "^0.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.16.5",
    "@types/react": "^18.3.8",
    "@types/react-dom": "^18.3.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.13",
    "postcss": "^8.4.47",
    "prisma": "5.19.0",
    "tailwindcss": "^3.4.11",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^5.6.2"
  }
}