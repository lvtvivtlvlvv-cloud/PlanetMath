datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                    String               @id @default(cuid())
  login                 String               @unique
  passwordHash          String
  role                  String               @default("STUDENT")
  fullName              String
  classId               String?
  plainPasswordForAdmin String?
  examTrack             String?              // "База" | "Профиль" (только для 11 класса)
  classGroup            ClassGroup?          @relation(fields: [classId], references: [id], onDelete: SetNull)
  submissions           HomeworkSubmission[]
  egeAssignments        EgeAssignment[]
  egeAssignmentItems    EgeAssignmentItem[]
  createdAt             DateTime             @default(now())

  @@index([login])
  @@index([classId])
}

model ClassGroup {
  id            String         @id @default(cuid())
  grade         Int
  letter        String
  name          String         @unique
  students      User[]
  scheduleItems ScheduleItem[]
  homeworks     Homework[]
}

model ScheduleItem {
  id           String     @id @default(cuid())
  classId      String
  dayOfWeek    Int
  lessonNumber Int
  startTime    String
  endTime      String
  subjectName  String
  room         String
  teacherName  String
  classGroup   ClassGroup @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@index([classId, dayOfWeek])
}

model Homework {
  id          String               @id @default(cuid())
  classId     String
  subjectName String
  targetDate  DateTime
  title       String
  description String
  targetTrack String?              // null | "ALL" | "База" | "Профиль" (только для 11 класса)
  createdAt   DateTime             @default(now())
  classGroup  ClassGroup           @relation(fields: [classId], references: [id], onDelete: Cascade)
  attachments Attachment[]
  submissions HomeworkSubmission[]

  @@index([classId, targetDate])
}

model HomeworkSubmission {
  id             String       @id @default(cuid())
  homeworkId     String
  studentId      String
  content        String
  submittedAt    DateTime     @default(now())
  status         String       @default("PENDING")
  grade          Int?
  teacherComment String?
  gradedAt       DateTime?
  homework       Homework     @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  student        User         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  attachments    Attachment[]

  @@unique([homeworkId, studentId])
  @@index([studentId])
  @@index([homeworkId])
}

model Attachment {
  id           String              @id @default(cuid())
  fileName     String
  fileUrl      String
  fileType     String
  fileSize     Int
  createdAt    DateTime            @default(now())
  expiresAt    DateTime
  homeworkId   String?
  submissionId String?
  homework     Homework?           @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  submission   HomeworkSubmission? @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model EgeTask {
  id          String              @id @default(cuid())
  taskNumber  Int                 // 1-19 (Номер задания профильного ЕГЭ)
  topic       String              // Тема (например, "Планиметрия: треугольники", "Векторы", "Уравнения")
  title       String              // Краткое название задания
  content     String              // Условие задания
  answer      String?             // Правильный ответ (для самопроверки/учителя)
  solution    String?             // Решение / критерии оценивания
  difficulty  String              @default("BASE") // "BASE" | "ADVANCED" | "HIGH"
  source      String              @default("FIPI") // "FIPI" | "MANUAL" | "IMPORT"
  createdAt   DateTime            @default(now())
  assignmentItems EgeAssignmentItem[]

  @@index([taskNumber])
}

model EgeAssignment {
  id             String              @id @default(cuid())
  title          String              // Название работы (например: "Тренировочная работа: Задания 1, 6, 12")
  teacherComment String?             // Комментарий / инструкции учителя
  assignedBy     String              @default("Учитель")
  targetClassId  String?             // ID класса, если выдано всему классу
  studentId      String?             // ID ученика, если выдано персонально
  targetTrack    String?             // "База" | "Профиль" | "ALL"
  deadline       DateTime?           // Срок выполнения
  createdAt      DateTime            @default(now())
  student        User?               @relation(fields: [studentId], references: [id], onDelete: Cascade)
  items          EgeAssignmentItem[]

  @@index([studentId])
  @@index([targetClassId])
}

model EgeAssignmentItem {
  id             String        @id @default(cuid())
  assignmentId   String
  taskId         String
  studentId      String        // Кому назначено
  orderIndex     Int           @default(0)
  studentAnswer  String?       // Ответ ученика
  studentComment String?       // Комментарий / пояснение ученика
  status         String        @default("ASSIGNED") // "ASSIGNED" | "SUBMITTED" | "GRADED"
  score          Int?          // Балл (0, 1, 2...)
  maxScore       Int           @default(1)
  teacherFeedback String?      // Замечание учителя
  submittedAt    DateTime?     // Время сдачи
  gradedAt       DateTime?     // Время проверки
  assignment     EgeAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  task           EgeTask       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  student        User          @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([assignmentId])
  @@index([studentId])
  @@index([taskId])
}